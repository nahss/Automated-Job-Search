# Copy to .env for local runs (never commit the real .env).
# In GitHub Actions these are set as repository secrets instead.

# --- Google Sheets ---
# The ENTIRE service-account JSON, as a single line. Share the target sheet
# with this service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@...iam.gserviceaccount.com"}
# The spreadsheet id (the long token in the sheet's URL).
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# --- LLM ---
# Default provider is Anthropic. Set LLM_PROVIDER=openai to swap.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic
# A CURRENT fast, low-cost model (Haiku-class). Do not pin a stale name.
LLM_MODEL=claude-haiku-5-5

# --- Product Hunt (Leads) ---
# Free developer token from https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=your_ph_developer_token

# --- Optional tuning ---
# SCORE_THRESHOLD=65
# TIMEZONE=Africa/Lagos
# REQUEST_DELAY_SECONDS=0.5
# USER_AGENT=AutomatedJobSearch/1.0 (+https://github.com/you; contact)

# --- Reddit (OPTIONAL) ---
# Only needed if you later upgrade reddit_gigs to the PRAW + OAuth path.
# The default keyless path needs none of these.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=AutomatedJobSearch/1.0 by u/yourname
